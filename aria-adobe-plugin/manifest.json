{
  "manifestVersion": 5,
  "id": "com.aria.adobebridge",
  "name": "ARIA Bridge",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    { "app": "PP", "minVersion": "24.0" },
    { "app": "AEFT", "minVersion": "24.0" }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "ariaPanel",
      "label": { "default": "ARIA Bridge" },
      "minimumSize": { "width": 300, "height": 400 },
      "preferredDockedSize": { "width": 360, "height": 520 },
      "preferredFloatingSize": { "width": 360, "height": 520 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://localhost:7777",
        "http://127.0.0.1:7777",
        "ws://localhost:7777",
        "ws://127.0.0.1:7777"
      ]
    },
    "localFileSystem": "fullAccess"
  }
}
